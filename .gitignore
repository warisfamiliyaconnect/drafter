# ==============================================================================
# Global & Monorepo Git Ignore Rules - Drafter
# ==============================================================================

# --- Operating System & IDE Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# --- Environment & Secret Keys ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.crt

# --- Python Virtual Environments ---
venv/
.venv/
drafterenv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Bytecode, Caches & Testing ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.black/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
*.egg-info/
.installed.cfg
*.egg
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
sdist/
wheels/
share/python-wheels/

# --- AI Engine Models & Large Weights ---
# Do not track large model weights (use LFS or cloud storage buckets)
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.h5
*.tflite
ai_engine/models/*
!ai_engine/models/.gitkeep
models/*
!models/.gitkeep
data/models/*
!data/models/.gitkeep
ai_engine/research/datasets/*.jsonl
ai_engine/research/datasets/*.csv

# --- Runtime Data, Exports & Logs ---
data/logs/*
!data/logs/.gitkeep
data/sessions/*
!data/sessions/.gitkeep
data/exports/*
!data/exports/.gitkeep
sessions/*
!sessions/.gitkeep
exports/*
!exports/.gitkeep
backend/data/*
!backend/data/.gitkeep
!backend/data/test_import.docx
backend/backend/
*.log
*.log.*
*.log.zip
backend/tests/server_log.txt
tests/server_log.txt

# --- Frontend (Node.js & Next.js) ---
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel/
next-env.d.ts
